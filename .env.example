# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Remote PostgreSQL: use its TLS connection URL and set PGSSLMODE=require.
PGSSLMODE=disable
PG_POOL_MAX=5
BOT1_TOKEN=
# Render generates a random 256-bit value. Local: run npm run secrets:generate.
TELEGRAM_WEBHOOK_SECRET=
# Render generates a random 256-bit internal service credential.
# Local: npm run secrets:generate creates it without printing the value.
BOT_SERVICE_KEY=
ADMIN_USERNAME=admin
# Render generates a random 256-bit Admin password if it does not already exist.
# Local: npm run secrets:generate. Store the result in a password manager.
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=
# Public legacy customer page only. Never include token, API key or password in this URL.
LEGACY_CUSTOMER_URL=
# Render Blueprint detects this URL from the Static Site; set only for local/custom-domain overrides.
TELEGRAM_GROUP_URL=
TELEGRAM_CHANNEL_URL=
PUBLIC_APP_URL=
PUBLIC_MINI_APP_URL=
ALLOWED_ORIGINS=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
SESSION_TTL_SECONDS=604800

# Bot phụ Aiogram. BOT2_TOKEN MUST differ from BOT1_TOKEN (grammY).
# Never use the production grammY token for the Aiogram service.
BOT2_TOKEN=
# Render generates a random 256-bit value for the Aiogram webhook.
AIOGRAM_WEBHOOK_SECRET=
AIOGRAM_PUBLIC_URL=
AIOGRAM_WEBHOOK_PATH=/telegram/webhook
HENDY_API_BASE_URL=
# Use the same secret value as API BOT_SERVICE_KEY; keep server-side only.
HENDY_BOT_SERVICE_KEY=
AIOGRAM_FSM_TTL_HOURS=24

# Optional: read-only Render inventory for the HENDY Operations Center.
# The key is used server-side only. Never expose it to the browser or bot services.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Tương thích chuyển tiếp: BOT_TOKEN và AIOGRAM_BOT_TOKEN được đọc khi BOT1_TOKEN/BOT2_TOKEN chưa có.
