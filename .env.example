# Runtime
NODE_ENV=development
PORT=10000
LOG_LEVEL=info

# PostgreSQL. Use a dedicated database and TLS for hosted providers.
DATABASE_URL=postgresql://hendy_multi_agent:change_me@localhost:5432/hendy_multi_agent
PGSSLMODE=disable
PG_POOL_MAX=5

# Admin login. Set long random values in Render Environment; never commit real secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ADMIN_PASSWORD_SALT=CHANGE_THIS_TO_A_RANDOM_SALT
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_HOURS=12

# LLM provider. Worker stays idle until both values are supplied.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=90000

# Worker tuning
MULTI_AGENT_ENABLED=false
MULTI_AGENT_WORKER_POLL_SECONDS=5
MULTI_AGENT_MAX_ATTEMPTS=3
MULTI_AGENT_STALE_MINUTES=15
MULTI_AGENT_CONCURRENCY=1

# Optional cross-origin access. Leave empty for same-origin dashboard/API.
CORS_ORIGINS=
