# Bot phụ Aiogram. Dùng token riêng, không dùng chung token của bot grammY chính.
BOT2_TOKEN=
AIOGRAM_WEBHOOK_SECRET=
# Use the Render URL of the Node.js API Web Service (not the Static Site).
HENDY_API_BASE_URL= # Render Blueprint injects the current API RENDER_EXTERNAL_URL
# Must be the same secret as BOT_SERVICE_KEY on the Node.js API service.
HENDY_BOT_SERVICE_KEY=
# Same PostgreSQL database as the Node.js API. Use TLS for external database connections.
DATABASE_URL=postgresql://user:password@host:5432/hendy
PGSSLMODE=require
PGSSL_CA_CERT=
# Public Static Site address used by Telegram Mini App.
PUBLIC_APP_URL= # Render injects the Static Site RENDER_EXTERNAL_URL through the API service
PUBLIC_MINI_APP_URL= # Leave empty to derive PUBLIC_APP_URL + /app
# Optional legacy customer page. Must be HTTPS; never include token or secret query parameters.
LEGACY_CUSTOMER_URL=
# The Render Web Service URL is injected automatically by Render as RENDER_EXTERNAL_URL.
AIOGRAM_WEBHOOK_PATH=/telegram/webhook
AIOGRAM_FSM_TTL_HOURS=24
PORT=10000
