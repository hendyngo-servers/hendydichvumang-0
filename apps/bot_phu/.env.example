# Bot phụ Aiogram. Dùng token riêng, không dùng chung token của bot grammY chính.
# BotFather token is user-provided; Render cannot mint Telegram Bot Tokens.
BOT2_TOKEN=
# Render generateValue: true creates this 256-bit webhook secret automatically.
AIOGRAM_WEBHOOK_SECRET=
# Render Blueprint injects the current API RENDER_EXTERNAL_URL.
# For local use, set the HTTPS origin of the Node.js API Web Service.
HENDY_API_BASE_URL=
# Automatically shared from the API's Render-generated BOT_SERVICE_KEY; do not copy it into source.
HENDY_BOT_SERVICE_KEY=
# Same PostgreSQL database as the Node.js API. Use TLS for external database connections.
DATABASE_URL=postgresql://user:password@host:5432/hendy
PGSSLMODE=require
PGSSL_CA_CERT=
# Render injects the Static Site RENDER_EXTERNAL_URL through the API service.
# For local use, set the HTTPS Static Site origin.
PUBLIC_APP_URL=
# Leave empty to derive PUBLIC_APP_URL + /app.
PUBLIC_MINI_APP_URL=
# Optional legacy customer page. Must be HTTPS; never include token or secret query parameters.
LEGACY_CUSTOMER_URL=
# The Render Web Service URL is injected automatically by Render as RENDER_EXTERNAL_URL.
AIOGRAM_WEBHOOK_PATH=/telegram/webhook
AIOGRAM_FSM_TTL_HOURS=24
PORT=10000
