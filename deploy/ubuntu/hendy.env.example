# Copy to hendy.env, fill values, then chmod 600. Never commit the real file.
APP_ENV=production
HENDY_PUBLIC_DOMAIN=bot.example.com
PORT=10000
BOT1_TOKEN=
ADMIN_ID=
ADMIN_IDS=
# Use the SAME PostgreSQL DB as the current Bot when preserving balances/orders.
DATABASE_URL=
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=false
WEBHOOK_AUTO_REGISTER=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
WEBSITE_PUBLIC_URL=https://hendydichvumang-szad.onrender.com
ALLOWED_ORIGINS=https://hendydichvumang-szad.onrender.com
BANK_WEBHOOK_ENABLED=false
WEBSOCKET_ENABLED=false
VIDEO_WORKER_ENABLED=false
CODE_TELEGRAM_ENABLED=false
CODE_TELEGRAM_WORKER_ENABLED=false
AI_MEDIA_QUEUE_ENABLED=false
AI_COVER_ENABLED=false
AI_COVER_WORKER_ENABLED=false
MULTI_AGENT_ENABLED=false
# Optional; keep empty unless the corresponding provider is configured and tested.
BOT1_PUBLIC_URL=
SUPPORT_URL=
GROUP_URL=
CHANNEL_URL=
HOMEPROXY_ENCRYPTION_KEY=
NEON_STORAGE_FUNCTION_URL=
NEON_STORAGE_FUNCTION_KEY=
HENDY_GITHUB_TOKEN=
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AI_COVER_WORKER_URL=
AI_COVER_CALLBACK_SECRET=
