# HENDY Ubuntu VPS runtime environment. Copy to hendy.env and chmod 600.
# Never commit the real hendy.env file.
APP_ENV=production
HENDY_PUBLIC_DOMAIN=bot.example.com
PORT=10000
# Compose injects APP_URL from HENDY_PUBLIC_DOMAIN.
WEBSITE_PUBLIC_URL=https://bot.example.com
# Comma-separated Website origins permitted to call this API. Same-origin is sufficient for one-domain VPS.
ALLOWED_ORIGINS=https://bot.example.com

# Single production Telegram bot.
BOT1_TOKEN=
ADMIN_ID=
ADMIN_IDS=
BOT1_PUBLIC_URL=
BOT_HOME_PHOTO=https://i.postimg.cc/HY1LRby9/hendy-home-banner.jpg?dl=1

# PostgreSQL remains the existing authoritative HENDY database (Neon or trusted PostgreSQL).
# Use the exact DB already holding HENDY users, wallet ledger, deposits and orders.
DATABASE_URL=
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=false
MIGRATION_EXPECTED_DATABASE=
WEBHOOK_AUTO_REGISTER=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_WEBHOOK_SECRET=
LEGACY_SESSION_SECRET=
WEBSITE_SESSION_TTL_SECONDS=43200

# Admin Git source editor: configure only if used; token is never committed.
HENDY_GITHUB_TOKEN=
HENDY_SOURCE_CONTROL_REPOSITORY=hendyngo-servers/hendydichvumang-0
HENDY_SOURCE_CONTROL_BASE_BRANCH=main

# Docker Compose worker profile is opt-in. Web container never runs queue workers on Ubuntu.
COMPOSE_PROFILES=
HENDY_INLINE_WORKERS=false

GROUP_URL=
CHANNEL_URL=
SUPPORT_URL=
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Financial callbacks remain locked until a bank-specific signature adapter is verified.
BANK_WEBHOOK_ENABLED=false
BANK_WEBHOOK_SECRET=

# Optional services are fail-closed until migrations, provider credentials and adapters are verified.
HOMEPROXY_ENCRYPTION_KEY=
NEON_STORAGE_FUNCTION_URL=
NEON_STORAGE_FUNCTION_KEY=
WEBSOCKET_ENABLED=false
WEBSOCKET_URL=
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_MAX_CONNECTIONS=250
WEBSOCKET_BIND=127.0.0.1
WEBSOCKET_PORT=10001

VIDEO_WORKER_ENABLED=false
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_PROCESSING_STALE_MINUTES=90

AI_MEDIA_QUEUE_ENABLED=false
AI_MEDIA_WORKER_POLL_SECONDS=5
AI_MEDIA_MAX_PER_DAY=3
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5

AI_COVER_ENABLED=false
AI_COVER_WORKER_ENABLED=false
AI_COVER_WORKER_URL=
AI_COVER_CALLBACK_SECRET=
AI_COVER_WORKER_POLL_SECONDS=5

MULTI_AGENT_ENABLED=false
MULTI_AGENT_WORKER_POLL_SECONDS=5
MULTI_AGENT_MAX_ATTEMPTS=3
MULTI_AGENT_STALE_MINUTES=15
MULTI_AGENT_OPENAI_MODEL=gpt-6.2-astra

CODE_TELEGRAM_ENABLED=false
CODE_TELEGRAM_WORKER_ENABLED=false
CODE_TELEGRAM_WORKER_POLL_SECONDS=5
CODE_TELEGRAM_MAX_VIDEO_BYTES=20971520

MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
BOT_HOME_PHOTO_ALLOWED_HOSTS=i.postimg.cc
