[Unit]
Description=HENDY Telegram Bot and Website API (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__HENDY_REPO_DIR__/deploy/ubuntu
ExecStart=/usr/bin/docker compose --env-file hendy.env up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file hendy.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
